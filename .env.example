# ── Self-hosted Postgres ──
# Owner/superuser connection — used by migrations and dev seed (bypasses RLS).
DATABASE_URL=postgres://localhost:5432/elections
# Least-privilege app role — used at runtime so RLS is enforced.
APP_DATABASE_URL=postgres://app:app_local_dev@localhost:5432/elections
# Password assigned to the `app` role by db/migrate.mjs.
APP_DB_PASSWORD=app_local_dev

# ── Realtime gateway ──
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# ── Default election for the single-page voter/admin (until /[org]/[election]
#    routing lands in Phase 4). Override per-request with ?org=&election=.
NEXT_PUBLIC_DEFAULT_ORG=demo
NEXT_PUBLIC_DEFAULT_ELECTION=spring-2026

# Auth note: there is no admin password anymore. Accounts live in the `users`
# table; sessions are DB-backed tokens (lib/auth.js). Email delivery (SMTP) for
# verification is pluggable and wired in a later phase.
