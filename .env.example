# ── Self-hosted Postgres (Phase 1) ──
# Owner/superuser connection — used by migrations and dev seed (bypasses RLS).
DATABASE_URL=postgres://localhost:5432/elections
# Least-privilege app role — used at runtime so RLS is enforced.
APP_DATABASE_URL=postgres://app:app_local_dev@localhost:5432/elections
# Password assigned to the `app` role by db/migrate.mjs.
APP_DB_PASSWORD=app_local_dev

# ── Legacy (Supabase) — still used by the not-yet-migrated voter/admin pages.
# Removed entirely in Phase 3 when realtime moves off Supabase Broadcast.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Admin/session (existing) ──
ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=change_me_to_a_long_random_string
