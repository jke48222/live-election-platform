# Copy to .env.local. These values match docker-compose.yml.

# ── Postgres ──
# Owner connection. Used only by db:migrate, db:seed and db:verify. The owner
# bypasses row-level security, so the web server and the gateway never use it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elections
# Least-privilege `app` role, used by the web server and the realtime gateway
# so that row-level security applies. `npm start`, and the gateway outside
# NODE_ENV=development, refuse to start without it. Both refuse a superuser,
# BYPASSRLS or owner role here: the gateway at startup, the web server on its
# first query.
APP_DATABASE_URL=postgres://app:app_local_dev@localhost:5432/elections
# Password db:migrate gives the `app` role. Outside NODE_ENV=development,
# db:migrate exits without it. It changes the password only when this is set.
APP_DB_PASSWORD=app_local_dev

# ── Realtime gateway ──
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001
# HMAC key for subscribe tickets and voter tags, 32 characters or more. The
# web server and the gateway must share the same value. `npm start` and the
# gateway refuse to start without it. This value is for your own machine
# only: generate a new one for any real deploy with `openssl rand -hex 32`.
REALTIME_SECRET=local-only-realtime-secret-replace-before-deploying
# Browser origins allowed to open a socket, comma-separated. Required unless
# the gateway runs with NODE_ENV=development. Open the app at this origin.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# The gateway requires a signed ticket to subscribe unless NODE_ENV is
# development. Set this to 1 to require one in development as well.
# REALTIME_REQUIRE_TICKET=1
# Set when the gateway sits behind a proxy that sets X-Forwarded-For.
# REALTIME_TRUST_PROXY=1
# REALTIME_MAX_CONNECTIONS_PER_IP=500

# ── Web server ──
# Number of proxies in front of the app that append to X-Forwarded-For. Unset
# means the app ignores X-Forwarded-For and X-Real-IP (clients can set both)
# and per-IP rate limits are off. Per-device limits and the slowdown on wrong
# room PINs still apply, but a client can make up new device ids, so set this
# in any real deploy.
# TRUSTED_PROXY_HOPS=1

# The election /admin opens when the URL has no ?org=&election=.
NEXT_PUBLIC_DEFAULT_ORG=demo
NEXT_PUBLIC_DEFAULT_ELECTION=spring-2026
# A production build links to a demo ballot from the landing page only when
# this names one, as <org>/<election>. Read at build time.
# DEMO_ELECTION=demo/spring-2026

# Accounts live in the `users` table and sessions are database-backed tokens
# (lib/auth.js). No email is sent yet: SMTP is not wired.
